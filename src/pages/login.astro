---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import { inputClasses, labelClasses, buttonClasses, cardClasses } from "../lib/utils";
---

<Layout title="Iniciar sesión — Mis Envíos">
  <main id="main-content" class="relative flex min-h-screen items-center justify-center overflow-hidden px-4">
    <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,color-mix(in_srgb,var(--color-primary)_16%,transparent),transparent_34%),radial-gradient(circle_at_80%_75%,color-mix(in_srgb,var(--color-accent)_13%,transparent),transparent_30%)]"></div>
    <div class="absolute right-4 top-4">
      <ThemeToggle />
    </div>
    <div class={`${cardClasses()} relative w-full max-w-sm p-8`}>
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.22em] text-primary">Tu centro logístico</p>
      <h1 class="font-display text-3xl font-bold tracking-tight text-text-main">Mis Envíos</h1>
      <p class="mt-2 text-sm text-text-muted">
        Te enviamos un enlace mágico a tu correo para entrar, sin contraseñas.
      </p>

      <form id="login-form" class="mt-6 space-y-4">
        <div>
          <label for="email" class={labelClasses()}>Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class={`mt-1.5 ${inputClasses()}`}
            placeholder="tu@correo.com"
          />
        </div>
        <button type="submit" class={`w-full ${buttonClasses("primary")}`}>
          Enviar enlace mágico
        </button>
      </form>

      <p id="login-message" class="mt-4 text-sm" role="status"></p>
    </div>
  </main>
</Layout>

<script>
  import { createClient } from "../lib/supabase/client";

  const supabase = createClient();
  const form = document.getElementById("login-form") as HTMLFormElement;
  const message = document.getElementById("login-message") as HTMLParagraphElement;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem("email") as HTMLInputElement).value;
    const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement;
    submitButton.disabled = true;
    message.textContent = "Enviando...";
    message.className = "mt-4 text-sm text-text-muted";

    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${window.location.origin}/auth/callback` },
    });

    submitButton.disabled = false;

    if (error) {
      const isRateLimited = error.status === 429 || error.code === "over_email_send_rate_limit" || error.code === "over_request_rate_limit";
      message.textContent = isRateLimited
        ? "Espera un minuto antes de solicitar otro enlace."
        : "No se pudo enviar el enlace. Intenta de nuevo.";
      message.className = "mt-4 text-sm text-danger";
    } else {
      message.textContent = "Revisa tu correo y haz clic en el enlace para entrar.";
      message.className = "mt-4 text-sm text-success";
    }
  });
</script>
